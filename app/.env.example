# DATABASE_URL — dibaca dari environment variable.
# Lokal/dev: SQLite file, mis. file:./dev.db
# Produksi (Vercel + Neon, database sudah dibuat Bang): postgres://...
#   -> diisi LANGSUNG sebagai Environment Variable di dashboard Vercel.
#   JANGAN pernah mengetik connection string di chat, dan JANGAN simpan
#   connection string asli di file ini / di repo.
DATABASE_URL="file:./dev.db"

# Password sementara akun Owner (maruf) saat seed pertama. WAJIB diganti Bang saat pertama login.
TEMP_OWNER_PASSWORD="maruf-2026-ganti"
